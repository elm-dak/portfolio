---
import TechLogo from './TechLogo.astro';
import { toolbox } from '../data/site';

// Icon shown for tools that have no brand logo in simple-icons
const fallbackFor: Record<string, 'brain' | 'database' | 'cloud'> = {
  'AI & ML': 'brain',
  Data: 'database',
  Databases: 'database',
  'DevOps & Cloud': 'cloud',
};
---

<section class="toolbox container" id="stack" aria-labelledby="toolbox-title" data-toolbox>
  <div class="section-head">
    <h2 class="section-title" id="toolbox-title"><span class="mask"><span>Toolbox</span></span></h2>
    <p class="section-lede" data-reveal>What I reach for, grouped by the kind of problem it solves.</p>
  </div>

  <div class="pan" data-pan>
    <div class="groups" data-pan-track>
      {
        toolbox.map((group) => (
          <div class="group" data-tool-group>
            <div class="group-top">
              <h3 class="group-name">{group.name}</h3>
              <span class="group-count mono">{group.tools.length} tools</span>
            </div>
            <ul class="tools">
              {group.tools.map((tool) => (
                <li class="tool" data-tool>
                  <TechLogo slug={tool.logo} fallback={fallbackFor[group.name] ?? 'database'} class="tool-logo" />
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="pan-progress" aria-hidden="true"><span data-pan-bar></span></div>
</section>

<style>
  .toolbox {
    padding-top: var(--section-space);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 5vw, 56px) clamp(32px, 5vw, 72px);
  }

  .group {
    display: grid;
    gap: 16px;
    align-content: start;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .group-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .group-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .group-count {
    display: none;
    color: var(--muted);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .tool :global(.tool-logo) {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--muted);
  }

  :global(html.motion) .tool {
    opacity: 0;
    transform: translateY(8px);
  }

  .pan-progress {
    display: none;
  }

  /*
   * Wide screens with motion: the groups become a row of panels that slides
   * sideways while the section is pinned (toolbox.ts). The same query is in DESKTOP.
   */
  @media (min-width: 901px) and (min-height: 621px) {
    :global(html.motion) .groups {
      display: flex;
      gap: 20px;
      width: max-content;
    }

    :global(html.motion) .group {
      width: clamp(360px, 31vw, 470px);
      min-height: min(50vh, 440px);
      padding: 30px;
      border: 1px solid var(--line);
      border-radius: var(--radius-card);
      background: var(--surface);
      gap: 28px;
      align-content: space-between;
    }

    :global(html.motion) .group:nth-child(even) {
      background: var(--bg-sunken);
    }

    :global(html.motion) .group-name {
      font-size: clamp(2rem, 3vw, 2.75rem);
      line-height: 1;
      letter-spacing: -0.045em;
    }

    :global(html.motion) .group-count {
      display: inline;
    }

    /* Panels show their tools as a grid of logo tiles */
    :global(html.motion) .tools {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    :global(html.motion) .tool {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      min-height: 86px;
      padding: 14px;
      border-radius: 16px;
      background: var(--bg);
      font-size: 0.875rem;
      line-height: 1.25;
      white-space: normal;
      transition:
        background-color 200ms ease,
        border-color 200ms ease;
    }

    :global(html.motion) .tool :global(.tool-logo) {
      width: 24px;
      height: 24px;
      color: var(--ink);
    }

    :global(html.motion) .tool:hover {
      border-color: var(--line-strong);
    }

    :global(html.motion) .group:nth-child(even) .tool {
      background: var(--surface);
    }

    :global(html.motion) .pan-progress {
      display: block;
      height: 2px;
      margin-top: 28px;
      background: var(--line);
      border-radius: 2px;
      overflow: hidden;
    }

    .pan-progress span {
      display: block;
      height: 100%;
      background: var(--accent);
      transform-origin: 0 50%;
      transform: scaleX(0);
    }
  }

  @media (max-width: 760px) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
