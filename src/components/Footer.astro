---
import Icon from './Icon.astro';
import { person } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer" data-footer>
  <div class="container">
    <p class="wordmark" aria-hidden="true" data-wordmark>
      {[...person.lastName].map((char) => <span class="wm-mask"><span class="wm-ch">{char}</span></span>)}
    </p>

    <div class="footer-row">
      <p class="copyright">
        © {year} {person.name}. Designed and built by me.
      </p>
      <ul class="social" aria-label="Elsewhere">
        <li>
          <a href={person.github} target="_blank" rel="noopener" aria-label="GitHub">
            <Icon name="github" />
          </a>
        </li>
        <li>
          <a href={person.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
        </li>
        <li>
          <a href={person.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
        </li>
        <li>
          <a href={`mailto:${person.email}`} aria-label="Email">
            <Icon name="envelope" />
          </a>
        </li>
      </ul>
      <a class="to-top" href="#top">
        Back to top
        <Icon name="arrow-up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: max(28px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    overflow: hidden;
    transition:
      background-color 700ms var(--ease-in-out),
      color 700ms var(--ease-in-out),
      border-color 700ms var(--ease-in-out);
  }

  .footer.is-inverted {
    --ink: #f6f7fb;
    --ink-soft: rgb(246 247 251 / 0.88);
    --muted: rgb(246 247 251 / 0.74);
    --line: rgb(246 247 251 / 0.24);
    --bg-sunken: rgb(246 247 251 / 0.12);
    --focus: #f6f7fb;
    background: #2b3be0;
    color: var(--ink);
  }

  :global([data-theme='dark']) .footer.is-inverted {
    background: #1f2bb3;
  }

  .wordmark {
    display: flex;
    justify-content: space-between;
    margin: clamp(24px, 4vw, 48px) -0.02em 0;
    font-size: clamp(4.5rem, 21.5vw, 20rem);
    font-weight: 700;
    line-height: 0.84;
    letter-spacing: -0.06em;
    color: var(--ink);
    user-select: none;
  }

  .wm-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }

  .wm-ch {
    display: block;
  }

  :global(html.motion) .wm-ch {
    transform: translateY(100%);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(24px, 3vw, 40px);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .social {
    display: flex;
    gap: 6px;
  }

  .social a,
  .to-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 999px;
    color: var(--ink-soft);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .social :global(svg),
  .to-top :global(svg) {
    width: 20px;
    height: 20px;
  }

  .to-top {
    padding: 0 12px;
    font-weight: 520;
  }

  .to-top :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (hover: hover) and (pointer: fine) {
    .social a:hover,
    .to-top:hover {
      color: var(--ink);
      background: var(--bg-sunken);
    }
  }
</style>
