---
import Icon from './Icon.astro';
import { person } from '../data/site';

const links = [
  { id: 'work', label: 'Work' },
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'certificates', label: 'Certificates' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner container">
    <a class="nav-brand" href="#top">
      <span class="nav-mark" aria-hidden="true">ED</span>
      <span class="nav-name">{person.name}</span>
      <span class="sr-only">, back to top</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={`#${link.id}`} data-nav-link={link.id}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm nav-cta" href="#contact">Let's talk</a>
      <button
        class="icon-btn nav-menu-btn"
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="menu"
        aria-expanded="false"
      >
        <Icon name="list" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="menu" data-menu aria-label="Menu">
  <div class="menu-top container">
    <span class="nav-brand">
      <span class="nav-mark" aria-hidden="true">ED</span>
      <span class="nav-name">{person.name}</span>
    </span>
    <button class="icon-btn" type="button" data-menu-close>
      <Icon name="x" />
      <span class="sr-only">Close menu</span>
    </button>
  </div>
  <nav class="menu-links container" aria-label="Sections">
    <ul>
      {
        [...links, { id: 'contact', label: "Let's talk" }].map((link, i) => (
          <li>
            <a href={`#${link.id}`} data-menu-link style={`--i: ${i}`}>
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu-foot container" data-menu-foot>
    <a href={`mailto:${person.email}`}>{person.email}</a>
    <div class="menu-social">
      <a href={person.github} target="_blank" rel="noopener">GitHub</a>
      <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={person.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</dialog>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      transform 260ms var(--ease-out),
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav.is-scrolled {
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav.is-scrolled {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .nav.is-hidden {
    transform: translateY(-100%);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .nav-links {
    position: relative;
    margin-inline: auto;
  }

  .nav-links ul {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .nav-links a[aria-current='true'] {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover {
      color: var(--ink);
    }
  }

  /* 1px wide, positioned and scaled to the active link by nav.ts */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 1px;
    height: 2px;
    background: var(--accent);
    transform-origin: left center;
    transform: translateX(0) scaleX(0);
    opacity: 0;
    transition:
      transform 300ms var(--ease-in-out),
      opacity 200ms ease;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    transition:
      transform 160ms var(--ease-out),
      border-color 200ms ease;
  }

  .icon-btn:active {
    transform: scale(0.94);
  }

  .icon-btn :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      border-color: var(--ink);
    }
  }

  .theme-toggle :global(.i-sun),
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle :global(.i-sun) {
    display: block;
  }

  .nav-menu-btn {
    display: none;
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-menu-btn {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .nav-name {
      display: none;
    }
  }

  /* Full-screen menu for small screens */

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--ink);
    opacity: 0;
    transition: opacity 220ms var(--ease-out);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    flex: none;
  }

  .menu-top .nav-name {
    display: inline;
  }

  .menu-links {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .menu-links ul {
    display: grid;
    gap: 4px;
  }

  .menu-links a {
    display: block;
    overflow: hidden;
    padding-block: 2px;
    font-size: clamp(2.5rem, 11vw, 4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .menu-links a span {
    display: block;
    transform: translateY(105%);
    transition: transform 420ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 45ms + 60ms);
  }

  .menu.is-open .menu-links a span {
    transform: translateY(0);
  }

  .menu-foot {
    display: grid;
    gap: 12px;
    padding-bottom: max(28px, env(safe-area-inset-bottom));
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .menu-social {
    display: flex;
    gap: 20px;
  }

  .menu-social a,
  .menu-foot > a {
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-links a span {
      transform: none;
      transition: none;
    }
  }
</style>
